{
  "name": "novel-crawler-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c yellow,cyan \"bun --hot run src/server/index.ts\" \"vite\"",
    "dev:server": "bun --hot run src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "NODE_ENV=production bun run src/server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "cg:init": "codegraph init -i",
    "cg:sync": "codegraph sync",
    "cg:status": "codegraph status",
    "cg:query": "codegraph query",
    "cg:callers": "codegraph callers",
    "cg:callees": "codegraph callees",
    "cg:impact": "codegraph impact"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "hono": "^4.7.7"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.2.0"
  }
}
